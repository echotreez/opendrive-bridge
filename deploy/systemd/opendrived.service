# systemd unit for the OpenDrive Bridge — a *user* unit (whitepaper §8.2).
#
# `odctl daemon install` writes this for you, with the real paths filled in.
# To do it by hand, replace /path/to/opendrive-bridge below with the folder you
# unpacked the release into, then:
#
#   mkdir -p ~/.config/systemd/user
#   cp opendrived.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now opendrived
#   systemctl --user status opendrived
#
# No sudo anywhere. That is the point of §8.2: the programs run from the folder
# you unpacked, your .env sits beside them, and uninstalling is deleting the
# folder.
#
# If you want the bridge to keep running when you are not logged in:
#
#   sudo loginctl enable-linger $USER
#
# WHY THIS IS NOT A SYSTEM UNIT ANY MORE
#
# It was, with DynamicUser=yes — a throwaway account with one writable
# directory. That is a good shape for a service with no user data and the wrong
# one here: the credentials are an encrypted .env in the user's own folder, and
# a dynamic user cannot read it. Neither could ProtectHome=yes, which was also
# in the old file. The hardening and the credential design were pulling in
# opposite directions, and the hardening would have won by breaking the daemon.

[Unit]
Description=OpenDrive Bridge daemon
Documentation=https://github.com/echotreez/opendrive-bridge/blob/main/docs/deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Absolute paths, both of them. A service manager does not read your shell
# configuration, so PATH is of no use here, and without WorkingDirectory the
# daemon would start in / and look for a .env that is not there.
ExecStart=/path/to/opendrive-bridge/opendrived
WorkingDirectory=/path/to/opendrive-bridge

Restart=on-failure
RestartSec=5s

# Long enough for the cache to finish uploading before systemd loses patience
# (§3.5.2 rule 4).
#
# This matters as soon as the caching gateway is on. With write-back, SIGTERM is
# the daemon's cue to flush files OpenDrive does not have yet, and the default it
# allows itself for that is two minutes (--cache-drain-timeout). systemd's own
# default here is ninety seconds, after which it sends SIGKILL — which would cut
# the drain short and leave files on disk that the user was told had been stored.
#
# So this is deliberately more than the drain's own budget: the daemon should be
# the thing that decides it has run out of time, because it is the thing that can
# then write down which files it did not finish. systemd killing it first produces
# the same data loss with no record of what was lost.
#
# If you raise --cache-drain-timeout, raise this too.
TimeoutStopSec=5min

# The daemon holds a password that unlocks somebody's whole cloud storage, so it
# gets as little of the machine as it can work with.
#
# What follows is a shorter list than the system unit had, and the difference is
# not carelessness. About half of systemd's sandboxing directives either do
# nothing in a user unit or stop it starting:
#
#   - ProtectKernelTunables, ProtectKernelModules, ProtectKernelLogs,
#     ProtectControlGroups, ProtectClock, RemoveIPC — these need privileges a
#     user service does not have, and systemd documents them as having no effect
#     for user units. Left in, they are decoration that reads like protection.
#   - ProtectHome=yes — actively wrong here: it hides /home, which is where .env
#     is. This one line would have broken the credential store.
#   - DynamicUser, StateDirectory — system-unit concepts, and both at odds with
#     "the user's own folder".
#
# What is left is the part that works unprivileged: seccomp filters, resource
# limits, and a namespace that keeps the rest of the filesystem read-only.
NoNewPrivileges=yes

# Everything outside the unpacked folder is read-only. ReadWritePaths has to
# name that folder explicitly — strict mode makes even $HOME read-only, and the
# daemon writes .env on first run and again on every token rotation.
ProtectSystem=strict
# One entry covers .env, the job state and the cache directory, because §8.2 puts
# all three in the folder the user unpacked. A cache directory placed anywhere
# else — another disk, say — needs its own ReadWritePaths line, and without one
# the daemon will report that it cannot write there rather than failing obscurely.
ReadWritePaths=/path/to/opendrive-bridge
PrivateTmp=yes

# It speaks HTTPS to OpenDrive and listens on a local socket; nothing else.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Transfers are the point, so no memory or CPU ceiling — but a descriptor limit
# still catches a runaway.
LimitNOFILE=8192

[Install]
WantedBy=default.target
