      "description": "Class Notes",
      "operations": [
        {
          "httpMethod": "GET",
          "nickname": "retrieveProjectLists",
          "responseClass": "Array",
          "parameters": [
            {
              "name": "session_id",
              "description": "Session ID.",
              "paramType": "query",
              "required": false,
              "allowMultiple": false,
              "dataType": "string"
            },
            {
              "name": "with_projects",
              "description": "Include projects in response.",
