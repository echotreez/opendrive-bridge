          "responseClass": "void",
          "parameters": [
            {
              "name": "REQUEST_BODY",
              "description": "Paste JSON data here with the following properties.<hr/>session_id : <tag>string</tag>  <i>(required)</i> - Session ID.<hr/>folder_id : <tag>string</tag>  <i>(required)</i> - Folder ID.<hr/>hash : <tag>string</tag>  <i>(required)</i> - Hash.",
              "required": true,
              "defaultValue": "{\n    \"session_id\": \"\",\n    \"folder_id\": \"\",\n    \"hash\": \"\"\n}",
              "paramType": "body",
              "allowMultiple": false,
              "dataType": "Object"
            }
          ],
          "summary": "Secure Folders authorization by hash. The second stage of Secure Folders authorization&nbsp; <i class=\"icon-lock icon-large\"></i>",
          "notes": "Secure Folders authorization by hash. The second stage of Secure Folders authorization",
          "errorResponses": [
            {
              "reason": "RestException",
              "code": 500
            }
          ]
        }
      ]
    },
    {
      "path": "/v1/securefolders/init.{format}",
      "description": "SecureFolders API",
      "operations": [
        {
          "httpMethod": "POST",
          "nickname": "createInit",
          "responseClass": "void",
          "parameters": [
            {
              "name": "REQUEST_BODY",
              "description": "Paste JSON data here with the following properties.<hr/>session_id : <tag>string</tag>  <i>(required)</i> - Session ID.<hr/>folder_id : <tag>string</tag>  <i>(required)</i> - Folder ID.<hr/>data : <tag>string</tag>  <i>(required)</i> - Data for password verification.<hr/>hash : <tag>string</tag>  <i>(required)</i> - Hash for password verification.",
              "required": true,
              "defaultValue": "{\n    \"session_id\": \"\",\n    \"folder_id\": \"\",\n    \"data\": \"\",\n    \"hash\": \"\"\n}",
              "paramType": "body",
              "allowMultiple": false,
              "dataType": "Object"
            }
          ],
          "summary": "Set password for secure folder&nbsp; <i class=\"icon-lock icon-large\"></i>",
          "notes": "Set password for secure folder",
          "errorResponses": [
            {
              "reason": "RestException",
              "code": 500
            }
          ]
        }
