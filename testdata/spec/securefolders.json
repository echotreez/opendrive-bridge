            {
              "name": "session_id",
              "description": "Session ID.",
              "paramType": "path",
              "required": true,
              "allowMultiple": false,
              "dataType": "string"
            },
            {
              "name": "folder_id",
              "description": "Folder ID.",
              "paramType": "path",
              "required": true,
              "allowMultiple": false,
              "dataType": "string"
            }
          ],
          "summary": "Request the data Secure Folders authorization. The first stage of Secure Folders authorization&nbsp; <i class=\"icon-lock icon-large\"></i>",
          "notes": "Request the data Secure Folders authorization. The first stage of Secure Folders authorization",
          "errorResponses": [
            {
              "reason": "RestException",
              "code": 500
            }
          ]
        }
      ]
    },
    {
      "path": "/v1/securefolders/auth.{format}",
